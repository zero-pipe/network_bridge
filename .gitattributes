# Normalise text files in the repository; check out with LF everywhere.
* text=auto eol=lf

*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.idl    text eol=lf
*.txt    text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binaries and prebuilt third-party archives.
*.a      binary
*.lib    binary
*.dll    binary
*.so*    binary
*.dylib  binary
*.exe    binary
*.obj    binary
*.o      binary
